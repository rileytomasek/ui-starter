{
  "name": "ui-starter",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-production.ts",
    "build:gallery": "vite build --mode gallery --outDir dist-gallery",
    "preview": "vite preview --host 127.0.0.1",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c oxlint.config.ts --report-unused-disable-directives-severity error .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm docs:check && pnpm typecheck && pnpm test && pnpm build",
    "ui:add": "shadcn add",
    "ui:icons": "node scripts/carbon-icons.ts",
    "setup:finalize": "node .starter/finalize.ts",
    "setup:baseline": "node .starter/refresh.ts",
    "test:setup": "node --test .starter/finalize.test.ts",
    "docs:check": "node scripts/check-docs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/carbon": "^1.2.28",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "0.2.3",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser-playwright": "5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8",
    "vitest": "5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "packageManager": "pnpm@11.14.0"
}
